{
  "name": "adversarial-rea",
  "version": "0.1.0",
  "description": "Adversarial reverse engineering harness - red team fork of REA with multi-agent exploitation workflows",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "adv-rea": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "analyze": "node bin/cli.js analyze",
    "swarm": "node bin/cli.js swarm",
    "hunt": "node bin/cli.js hunt",
    "test": "node --test test/unit/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/unit/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "p-limit": "^6.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "reverse-engineering",
    "exploitation",
    "red-team",
    "vulnerability-research",
    "binary-analysis"
  ],
  "license": "MIT"
}
